@page
@model pre_Piscinas_asp_JQ.Pages.ReservarModel

<h2>Reservar Piscina</h2>

<form method="post">

    <div class="mb-3">
        <label>Id Piscina</label>
        <input asp-for="PiscinaId" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Edad</label>
        <input asp-for="Edad" class="form-control" />
    </div>

    <div class="mb-3">
        <input asp-for="EsFechaEspecial" type="checkbox" />
        <label>Fecha Especial</label>
    </div>

    <button type="submit" class="btn btn-primary">
        Calcular
    </button>

</form>

@if (Model.Mensaje != null)
{
    <div class="alert alert-info mt-3">
        @Model.Mensaje
    </div>
}